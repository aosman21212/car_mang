<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ Car Vehicle – List ═══ -->
    <record id="view_car_vehicle_list" model="ir.ui.view">
        <field name="name">car.vehicle.list</field>
        <field name="model">car.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles" decoration-muted="state == 'sold' or state == 'scrapped'"
                  decoration-warning="state == 'maintenance'">
                <field name="image" widget="image" optional="show" class="o_image_40_cover"/>
                <field name="name"/>
                <field name="brand_id"/>
                <field name="model_id"/>
                <field name="year"/>
                <field name="license_plate"/>
                <field name="vin" optional="hide"/>
                <field name="color" optional="show"/>
                <field name="mileage"/>
                <field name="owner_id" optional="show"/>
                <field name="last_service_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'maintenance'"
                       decoration-info="state == 'in_use'"
                       decoration-danger="state in ('sold', 'scrapped')"/>
            </list>
        </field>
    </record>

    <!-- ═══ Car Vehicle – Form ═══ -->
    <record id="view_car_vehicle_form" model="ir.ui.view">
        <field name="name">car.vehicle.form</field>
        <field name="model">car.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <header>
                    <button name="action_set_available" string="Set Available"
                            type="object" invisible="state == 'available'"
                            class="btn-secondary"/>
                    <button name="action_set_in_use" string="Mark In Use"
                            type="object" invisible="state == 'in_use'"
                            class="btn-primary"/>
                    <button name="action_set_maintenance" string="Send to Maintenance"
                            type="object" invisible="state == 'maintenance'"
                            class="btn-warning"/>
                    <button name="action_set_sold" string="Mark as Sold"
                            type="object" invisible="state in ('sold', 'scrapped')"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,in_use,maintenance,sold"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                type="object"
                                name="action_view_services"
                                icon="fa-wrench">
                            <field name="service_count" widget="statinfo" string="Services"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Vehicle Details">
                            <field name="model_id"/>
                            <field name="brand_id"/>
                            <field name="year"/>
                            <field name="color"/>
                            <field name="vin"/>
                            <field name="license_plate"/>
                        </group>
                        <group string="Ownership &amp; Status">
                            <field name="owner_id"/>
                            <field name="purchase_date"/>
                            <field name="purchase_price"/>
                            <field name="mileage"/>
                            <field name="last_service_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══ Car Vehicle – Kanban ═══ -->
    <record id="view_car_vehicle_kanban" model="ir.ui.view">
        <field name="name">car.vehicle.kanban</field>
        <field name="model">car.vehicle</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="brand_id"/>
                <field name="model_id"/>
                <field name="license_plate"/>
                <field name="year"/>
                <field name="mileage"/>
                <field name="state"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <field name="image" widget="image" class="o_image_64_cover float-end ms-2"/>
                        <strong class="o_kanban_record_title">
                            <field name="name"/>
                        </strong>
                        <div class="o_kanban_record_subtitle text-muted">
                            <field name="license_plate"/>
                            <span t-if="record.year.value"> — <t t-esc="record.year.value"/></span>
                        </div>
                        <div class="mt-1">
                            <span class="badge rounded-pill text-bg-secondary">
                                <t t-esc="record.mileage.value"/> km
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══ Car Vehicle – Search ═══ -->
    <record id="view_car_vehicle_search" model="ir.ui.view">
        <field name="name">car.vehicle.search</field>
        <field name="model">car.vehicle</field>
        <field name="arch" type="xml">
            <search string="Search Vehicles">
                <field name="name" string="Vehicle"/>
                <field name="license_plate"/>
                <field name="vin"/>
                <field name="brand_id"/>
                <field name="model_id"/>
                <field name="owner_id"/>
                <separator/>
                <filter string="Available" name="available" domain="[('state','=','available')]"/>
                <filter string="In Use" name="in_use" domain="[('state','=','in_use')]"/>
                <filter string="Under Maintenance" name="maintenance" domain="[('state','=','maintenance')]"/>
                <filter string="Sold" name="sold" domain="[('state','=','sold')]"/>
                <separator/>
                <separator/>
                <filter string="Brand" name="group_brand" context="{'group_by': 'brand_id'}"/>
                <filter string="Model" name="group_model" context="{'group_by': 'model_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Year" name="group_year" context="{'group_by': 'year'}"/>
                <filter string="Owner" name="group_owner" context="{'group_by': 'owner_id'}"/>
            </search>
        </field>
    </record>

    <!-- ═══ Car Vehicle – Action ═══ -->
    <record id="action_car_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">car.vehicle</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
        <field name="search_view_id" ref="view_car_vehicle_search"/>
        <field name="context">{}</field>
    </record>

</odoo>
