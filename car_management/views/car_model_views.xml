<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ Car Model – List ═══ -->
    <record id="view_car_model_list" model="ir.ui.view">
        <field name="name">car.model.list</field>
        <field name="model">car.model</field>
        <field name="arch" type="xml">
            <list string="Car Models">
                <field name="brand_id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="fuel_type"/>
                <field name="seats"/>
                <field name="vehicle_count" string="Vehicles"/>
            </list>
        </field>
    </record>

    <!-- ═══ Car Model – Form ═══ -->
    <record id="view_car_model_form" model="ir.ui.view">
        <field name="name">car.model.form</field>
        <field name="model">car.model</field>
        <field name="arch" type="xml">
            <form string="Car Model">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                type="object"
                                name="action_view_vehicles"
                                icon="fa-car"
                                invisible="vehicle_count == 0">
                            <field name="vehicle_count" widget="statinfo" string="Vehicles"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Model Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="brand_id"/>
                            <field name="category"/>
                            <field name="fuel_type"/>
                        </group>
                        <group>
                            <field name="seats"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══ Car Model – Action ═══ -->
    <record id="action_car_model" model="ir.actions.act_window">
        <field name="name">Car Models</field>
        <field name="res_model">car.model</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
