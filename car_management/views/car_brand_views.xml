<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ Car Brand – List ═══ -->
    <record id="view_car_brand_list" model="ir.ui.view">
        <field name="name">car.brand.list</field>
        <field name="model">car.brand</field>
        <field name="arch" type="xml">
            <list string="Car Brands">
                <field name="logo" widget="image" optional="show" class="o_image_40_cover"/>
                <field name="name"/>
                <field name="country_id"/>
                <field name="model_count" string="Models"/>
            </list>
        </field>
    </record>

    <!-- ═══ Car Brand – Form ═══ -->
    <record id="view_car_brand_form" model="ir.ui.view">
        <field name="name">car.brand.form</field>
        <field name="model">car.brand</field>
        <field name="arch" type="xml">
            <form string="Car Brand">
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar" options="{'preview_image': 'logo'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Brand Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="country_id"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Models" name="models">
                            <field name="model_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="fuel_type"/>
                                    <field name="seats"/>
                                    <field name="vehicle_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══ Car Brand – Action ═══ -->
    <record id="action_car_brand" model="ir.actions.act_window">
        <field name="name">Car Brands</field>
        <field name="res_model">car.brand</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
